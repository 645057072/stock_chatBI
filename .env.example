# 复制为 .env 后由 docker compose 与本地 uvicorn 读取
MYSQL_ROOT_PASSWORD=devroot

# MySQL root 密码说明（与现有代码兼容）：
# - 含 @、#、! 等一般可正常使用；API 使用 SQLAlchemy URL.create，不会对密码做错误拼接。
# - 若密码含空格，建议整段加引号，例如：MYSQL_ROOT_PASSWORD='AAA aa@123'
# - 尽量避免密码首字符为「-」，以及少用裸双引号、反引号、未转义的 $（Compose/.env 插值易踩坑）。

# 若 MySQL 容器反复 Exited(1) 且日志含 Inappropriate ioctl：先更新 docker-compose 后重建；
# 若数据可丢弃，可 docker compose down -v 清空 chatbi_mysql_data 再 up（会丢失本库数据）。

# Docker 编排下请勿设置 MYSQL_HOST / MYSQL_PORT（容器内应连服务名 mysql；若必须自定义，请用 CHATBI_MYSQL_HOST=mysql）

# 通义千问（必填，否则助手无法推理）
DASHSCOPE_API_KEY=

# 可选：Tushare 实时行情补充
TUSHARE_TOKEN=

# 与本机其他项目隔离的宿主机端口（推荐：Ai_Eaxm_system 用 80，本 ChatBI 用 18080 / 18443，互不抢占）
CHATBI_HTTP_PORT=18080
CHATBI_HTTPS_PORT=18443

# 中间件：本栈固定 MySQL 13306、Redis 16379（容器内与宿主机 127.0.0.1 映射一致，不再使用 3306/6379）

# 建议在服务器设置唯一 Compose 项目名，避免与其它工程网络/卷重名
COMPOSE_PROJECT_NAME=chatbi_case_prod

# 本地直接跑 API（非 Docker）时可设 false，便于 http:// 下调试 Cookie
COOKIE_SECURE=false
