# 复制为 .env 后由 docker compose 与本地 uvicorn 读取；ECS 首次部署可执行 ./ecs-first-up.sh

# ---------- MySQL（内置容器或阿里云 RDS 等均通过下列变量配置 API 连接）----------
#
# 【用户名与密码（内置 MySQL 容器）】
# - 登录用户：MYSQL_USER，默认 root（即数据库里的 root 账号）。
# - root 口令：只看 MYSQL_ROOT_PASSWORD。官方镜像仅在「数据目录第一次初始化」时把它写入库内；
#   若数据卷已存在，你再改 .env 里的密码不会自动同步到库里，需 docker compose down -v 重建（会丢数据）或在库内手动改密码。
# - API / 应用连库口令：MYSQL_PASSWORD，内置场景必须与 MYSQL_ROOT_PASSWORD 完全一致（否则 API 报 Access denied）。
# - Navicat 若映射宿主机端口后连接：用户名 root，密码 = 与本文件 MYSQL_ROOT_PASSWORD 完全相同（勿与别处手写密码混用，注意 @、g 等字符是否抄错）。
#
# 【宿主机连接 MySQL】compose 已将容器 3309 映射到宿主机 3309；Navicat 填「127.0.0.1:3309」或 ECS 内网 IP:3309。
#   若仍 10061：检查防火墙/安全组是否放行；公网直连务必限制来源 IP 并强密码。
#
MYSQL_ROOT_PASSWORD=devroot
# API 连库密码：内置时请与 MYSQL_ROOT_PASSWORD 一致；不写则 compose 会用 MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=devroot
MYSQL_USER=root
MYSQL_DATABASE=chat_bi_case
# 内置 MySQL：容器内与宿主机映射均为 3309。API 在容器内连主机名「mysql」（Compose DNS）。
# 勿填 chatbi_case_prod_mysql 等 container_name：第二次 docker compose up 后易出现应用进程内 Name or service not known。
# 外置 RDS 时再设置 CHATBI_MYSQL_HOST 为 RDS 地址。
# CHATBI_MYSQL_HOST=
CHATBI_MYSQL_PORT=3309

# MySQL root 密码说明（与现有代码兼容）：
# - 含 @、#、! 等一般可正常使用；API 使用 SQLAlchemy URL.create，不会对密码做错误拼接。
# - 若密码含空格，建议整段加引号，例如：MYSQL_ROOT_PASSWORD='AAA aa@123'
# - 尽量避免密码首字符为「-」，以及少用裸双引号、反引号、未转义的 $（Compose/.env 插值易踩坑）。

# 若 MySQL 容器反复 Exited(1) 且日志含 Inappropriate ioctl：确保镜像与 compose 已更新（含 shm_size、innodb 参数）；
# 若数据可丢弃，可 docker compose down -v 清空 chatbi_mysql_data 再 up（会丢失本栈数据）。
# 更新 api 镜像后建议执行：docker compose up -d --force-recreate api（丢弃旧容器层里可能错误的 /etc/hosts）。
# Docker Compose 内置 MySQL：compose 已设置 CHATBI_MYSQL_DNS_NAME=mysql（供连接重试回退，勿删）。
# 若改用阿里云 RDS，请删去该项或置空，并设置 CHATBI_MYSQL_HOST 为 RDS 地址。

# ---------- Redis ----------
# 内置 Redis：容器内 redis://redis:6381/0；宿主机调试可用 127.0.0.1:6381。外置云 Redis 时再填写 REDIS_URL
# REDIS_URL=

# ---------- Web 对外端口（勿与其它应用冲突；18080/18443 被占用时可改为 28080/28443 等）----------
CHATBI_HTTP_PORT=18080
CHATBI_HTTPS_PORT=18443
# 若浏览器报 net::ERR_CONNECTION_REFUSED：多为 nginx 未运行、端口非 CHATBI_HTTP_PORT，或宿主机防火墙未放行。执行 docker compose ps -a 与 docker compose logs nginx；前端已改为提示「无法连接服务器」而非控制台裸抛 TypeError。

# ---------- Nginx 反代网关（仅 nginx 容器读取；助手推理较慢时出现「网关无法连接后端」可适当加大超时）----------
# Compose 内 API：填写「主机名:端口」，勿带 http://（模板里拼成 http://$chatbi_upstream/）
# CHATBI_API_UPSTREAM=api:8000
# 反代读/写超时（对话耗时长建议 600s～900s）
# CHATBI_NGINX_PROXY_TIMEOUT=600s
# 浏览器控制台 502 Bad Gateway：多为 api 未就绪/崩溃、CHATBI_API_UPSTREAM 写错（须与 compose 服务名一致）、或更新代码后未重建 nginx。
#   排查：docker compose ps；docker compose logs api --tail 80；docker compose up -d --force-recreate api nginx

# ---------- 前端构建（docker compose build nginx 时传入 webbuild；默认 /api 与网关一致）----------
# 直连后端调试时可设为完整地址（需后端 CORS，本仓库默认未开启跨域）：http://127.0.0.1:8000
# VITE_API_PREFIX=/api

# ---------- 业务密钥 ----------
# 通义千问（必填，否则助手无法推理）
DASHSCOPE_API_KEY=
# 若对话报错「Failed to resolve dashscope.aliyuncs.com」「Errno -3」：多为容器对外 DNS；compose 已为 api 追加 223.5.5.5 备用 DNS，
# 请执行 docker compose up -d --force-recreate api；仍失败请检查 ECS 出站策略 / 是否禁用公网 DNS。
# 可选：Tushare（实时补充 + sync_stock_daily 联网写入 stock_daily）；不配置则无法自动补库
TUSHARE_TOKEN=

# ---------- Docker 构建（ECS 访问官方 PyPI/npm 易失败；可不配置，compose 已默认国内镜像）----------
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
# 境外构建可改为官方：PIP_INDEX_URL=https://pypi.org/simple 且 PIP_TRUSTED_HOST=pypi.org
# NPM_REGISTRY=https://registry.npmmirror.com
# NPM_REGISTRY=https://registry.npmjs.org

# ---------- 其它 ----------
# 项目名决定 docker 容器显示名（便于 logs）；连库主机名默认仍为服务名 mysql/redis，与该项无关
COMPOSE_PROJECT_NAME=chatbi_case_prod
# 仅 HTTPS 部署且浏览器走 https 时设为 true；HTTP 调试设为 false
COOKIE_SECURE=false
