# 复制为 .env 后由 docker compose 与本地 uvicorn 读取；ECS 首次部署可执行 ./ecs-first-up.sh

# ---------- MySQL（内置容器或阿里云 RDS 等均通过下列变量配置 API 连接）----------
MYSQL_ROOT_PASSWORD=devroot
# API 连库密码：可与 MYSQL_ROOT_PASSWORD 相同；若不写此项，docker-compose 会默认使用 MYSQL_ROOT_PASSWORD（避免 API 仍用 devroot 而库已是其它密码）
MYSQL_PASSWORD=devroot
MYSQL_USER=root
MYSQL_DATABASE=chat_bi_case
# 内置 MySQL：端口 3309。主机名默认「COMPOSE_PROJECT_NAME + _mysql」容器名（见 docker-compose），勿填 mysql 除非确认该名可解析
# CHATBI_MYSQL_HOST=
CHATBI_MYSQL_PORT=3309

# MySQL root 密码说明（与现有代码兼容）：
# - 含 @、#、! 等一般可正常使用；API 使用 SQLAlchemy URL.create，不会对密码做错误拼接。
# - 若密码含空格，建议整段加引号，例如：MYSQL_ROOT_PASSWORD='AAA aa@123'
# - 尽量避免密码首字符为「-」，以及少用裸双引号、反引号、未转义的 $（Compose/.env 插值易踩坑）。

# 若 MySQL 容器反复 Exited(1) 且日志含 Inappropriate ioctl：确保镜像与 compose 已更新（含 shm_size、innodb 参数）；
# 若数据可丢弃，可 docker compose down -v 清空 chatbi_mysql_data 再 up（会丢失本栈数据）。

# ---------- Redis ----------
# 内置 Redis：compose 默认 redis://${COMPOSE_PROJECT_NAME}_redis:6381/0；无需写 REDIS_URL。外置云 Redis 时再填写，例如 redis://:密码@r-xx.redis.rds.aliyuncs.com:6379/0
# REDIS_URL=

# ---------- Web 对外端口（勿与其它应用冲突；18080/18443 被占用时可改为 28080/28443 等）----------
CHATBI_HTTP_PORT=18080
CHATBI_HTTPS_PORT=18443

# ---------- 业务密钥 ----------
# 通义千问（必填，否则助手无法推理）
DASHSCOPE_API_KEY=
# 可选：Tushare 实时行情补充
TUSHARE_TOKEN=

# ---------- Docker 构建（ECS 访问官方 PyPI/npm 易失败；可不配置，compose 已默认国内镜像）----------
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
# 境外构建可改为官方：PIP_INDEX_URL=https://pypi.org/simple 且 PIP_TRUSTED_HOST=pypi.org
# NPM_REGISTRY=https://registry.npmmirror.com
# NPM_REGISTRY=https://registry.npmjs.org

# ---------- 其它 ----------
# 项目名决定内置 MySQL/Redis 容器名（chatbi_case_prod_mysql / chatbi_case_prod_redis）；勿在 .env 写 CHATBI_MYSQL_HOST=mysql，否则会覆盖 compose 默认导致解析失败
COMPOSE_PROJECT_NAME=chatbi_case_prod
# 仅 HTTPS 部署且浏览器走 https 时设为 true；HTTP 调试设为 false
COOKIE_SECURE=false
