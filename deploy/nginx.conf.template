# ChatBI 入口：静态资源 + /api 反代（超时与上游由容器环境变量注入，见 .env.example）
# 仅占位符 ${CHATBI_API_UPSTREAM}、${CHATBI_NGINX_PROXY_TIMEOUT} 由 envsubst 替换；其余 $host 等保留给 Nginx
#
# 不在静态 upstream { server api:8000 } 里写死主机名：api 容器重建后 IP 会变，Nginx 会缓存旧 IP 导致 502。
# 使用 127.0.0.11（Docker 内置 DNS）+ 变量 proxy_pass，按 valid 周期重新解析。

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    location /api/ {
        resolver 127.0.0.11 ipv6=off valid=10s;
        resolver_timeout 5s;
        # 变量上游须 resolver。仅用 proxy_pass 尾部 / 在部分环境下不会去掉 /api/，上游收到 /api/auth/... 而 FastAPI 路由为 /auth/... 会 404；
        # 使用 rewrite break 显式去前缀；set 须在 rewrite 之前。
        set $chatbi_upstream "${CHATBI_API_UPSTREAM}";
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$chatbi_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout ${CHATBI_NGINX_PROXY_TIMEOUT};
        proxy_send_timeout ${CHATBI_NGINX_PROXY_TIMEOUT};
        proxy_read_timeout ${CHATBI_NGINX_PROXY_TIMEOUT};
        client_max_body_size 20m;
        # 仅关闭缓冲即可；勿单独加大 proxy_buffer_size 或 proxy_busy_buffers_size，易触发
        # 「proxy_busy_buffers_size must be less than all proxy_buffers minus one buffer」导致 nginx -t 失败
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    location /api/ {
        resolver 127.0.0.11 ipv6=off valid=10s;
        resolver_timeout 5s;
        # 变量上游须 resolver。仅用 proxy_pass 尾部 / 在部分环境下不会去掉 /api/，上游收到 /api/auth/... 而 FastAPI 路由为 /auth/... 会 404；
        # 使用 rewrite break 显式去前缀；set 须在 rewrite 之前。
        set $chatbi_upstream "${CHATBI_API_UPSTREAM}";
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$chatbi_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout ${CHATBI_NGINX_PROXY_TIMEOUT};
        proxy_send_timeout ${CHATBI_NGINX_PROXY_TIMEOUT};
        proxy_read_timeout ${CHATBI_NGINX_PROXY_TIMEOUT};
        client_max_body_size 20m;
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
